// Структура базы данных бота.
// После изменения этого файла создайте миграцию: npx prisma migrate dev --name <название>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  NEW
  ACCEPTED
  COOKING
  DELIVERING
  READY
  COMPLETED
  CANCELLED
}

// Клиент (id = Telegram ID)
model User {
  id        BigInt     @id
  firstName String?
  lastName  String?
  username  String?
  language  String?
  name      String? // имя, указанное при заказе
  phone     String?
  address   String? // последний адрес доставки
  checkout  Json? // незавершённое оформление заказа
  isBlocked Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  orders    Order[]
}

model Category {
  id        String    @id
  name      Json
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Блюдо. Данные приходят из restaurant/menu.yaml, inStock меняет администратор (стоп-лист)
model Product {
  id          String     @id
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  name        Json
  description Json?
  price       Decimal    @db.Decimal(12, 2)
  oldPrice    Decimal?   @db.Decimal(12, 2)
  weight      Json?
  photo       String?
  photoFileId String?
  spicy       Int        @default(0)
  badges      String[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  inStock     Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
  cartItems   CartItem[]
}

model CartItem {
  userId    BigInt
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Order {
  id            Int            @id @default(autoincrement())
  userId        BigInt
  user          User           @relation(fields: [userId], references: [id])
  status        OrderStatus    @default(NEW)
  method        DeliveryMethod
  items         Json // [{ productId, name, price, quantity }]
  itemsTotal    Decimal        @db.Decimal(12, 2)
  deliveryFee   Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  customerName  String
  phone         String
  address       String?
  latitude      Float?
  longitude     Float?
  comment       String?
  paymentMethod String?
  language      String?
  adminMessages Json? // [{ chatId, messageId }]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Вопросы клиентов к AI-помощнику (помогают понять, какой информации не хватает)
model AiQuestion {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  question  String
  answer    String
  found     Boolean
  createdAt DateTime @default(now())

  @@index([found, createdAt])
}
