# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую. Узнать свой ID: отправьте боту команду /id
ADMIN_IDS=

# Необязательно: ID группы сотрудников, куда будут приходить заказы
ORDERS_CHAT_ID=

# Строка подключения к базе данных PostgreSQL (например, Neon)
DATABASE_URL=

# Ключ Claude API для AI-помощника: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_QUESTIONS_PER_HOUR=20

# Mini App (веб-меню внутри Telegram)
WEBAPP_PORT=3001
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
MINI_APP_URL=
